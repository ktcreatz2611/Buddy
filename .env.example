# Database
DATABASE_URL=postgresql://buddy:buddy_dev@localhost:5432/buddy

# Redis
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=change-me-to-a-random-32-char-string
AUTH_URL=http://localhost:3000

# Encryption (32-byte hex key for AES-256-GCM - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=change-me-generate-with-crypto-randombytes-32

# Provider API Keys (add as needed)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...

# App
NODE_ENV=development
